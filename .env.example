# ==========================================
# 🚌 BUS ATTENDANCE MANAGEMENT SYSTEM — ENV
# ==========================================

# SERVER CONFIGURATION & AUTH
PORT=3001
NODE_ENV=development
JWT_SECRET=replace_with_your_jwt_secret_min_32_chars
AUTH_SECRET=replace_with_your_auth_secret_min_32_chars

# ------------------------------------------
# SUPABASE POSTGRESQL DATABASE
# ------------------------------------------
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# OPTIONAL: SUPABASE REALTIME CLIENT (Instant Frontend Dashboard Sync)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------
# BREVO TRANSACTIONAL EMAIL ENGINE (v3 API)
# ------------------------------------------
# Obtain from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_v3_here
BREVO_SENDER_EMAIL=transport@college.edu
BREVO_SENDER_NAME="VSB Engineering College Transit System"

# ------------------------------------------
# CLOUDINARY MEDIA & ID CARD PIPELINE
# ------------------------------------------
# Obtain from https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ------------------------------------------
# CAMPUS & TRANSIT DEFAULT GEOFENCING
# ------------------------------------------
DEFAULT_CAMPUS_LAT=10.9572
DEFAULT_CAMPUS_LNG=78.0766
DEFAULT_GEOFENCE_RADIUS_METERS=10

# ------------------------------------------
# DUAL-CLOUD AI LOAD-BALANCED FACE VERIFICATION (GEMINI & GROQ)
# ------------------------------------------
# Google Gemini Vision (Free via https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
# Groq Cloud Vision (Free via https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
