# ==========================================
# 🚌 BUS ATTENDANCE MANAGEMENT SYSTEM — ENV
# ==========================================

# SERVER CONFIGURATION
PORT=3001
NODE_ENV=development
JWT_SECRET=replace_with_your_jwt_secret_min_32_chars

# ------------------------------------------
# SUPABASE POSTGRESQL DATABASE
# ------------------------------------------
# Find these in your Supabase project dashboard -> Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres
STORAGE_DRIVER=postgres

# ------------------------------------------
# BREVO TRANSACTIONAL EMAIL ENGINE (v3 API)
# ------------------------------------------
# Obtain from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_v3_here
BREVO_SENDER_EMAIL=transport@college.edu
BREVO_SENDER_NAME="College Bus Transit System"

# ------------------------------------------
# CLOUDINARY MEDIA & ID CARD PIPELINE
# ------------------------------------------
# Obtain from https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ------------------------------------------
# CAMPUS & TRANSIT DEFAULT GEOFENCING
# ------------------------------------------
CAMPUS_NAME="VSB Engineering College Campus"
DEFAULT_CAMPUS_LAT=12.9716
DEFAULT_CAMPUS_LNG=77.5946
DEFAULT_GEOFENCE_RADIUS_METERS=150
MAX_GPS_ACCURACY_METERS=80
DEFAULT_CODE_ROTATION_SECONDS=60

# ------------------------------------------
# CLOUD AI FACE VERIFICATION & VISION ENGINES
# ------------------------------------------
EDENAI_API_KEY=your_edenai_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEYS=your_groq_api_keys_comma_separated_here

